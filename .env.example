# pipeline-gateway 配置示例
# 复制为 .env 后 chmod 600。本进程只做搬运，不持有语义状态。

# ── 监听 ────────────────────────────────────────
# 灰度验证用 18232 并行起一份；稳定后改 18220 让客户端无感
PIPELINE_PORT=18232
PIPELINE_HOST=0.0.0.0
# 与 cadence 同一枚 token，客户端无需改动
PIPELINE_TOKEN=

# ── 下游：Lattice 网关（注入的终点，最终由它发给上游模型）──
UPSTREAM_BASE=http://127.0.0.1:18217
UPSTREAM_TOKEN=

# ── 上游生产者：cadence（判断层，注入源 + 判定器 + MCP + surf 回投）──
CADENCE_BASE=http://127.0.0.1:18221
CADENCE_TOKEN=

# ── 注入开关与缓存 ──────────────────────────────
INJECT_ENABLED=true
BLOCK_CACHE_MS=30000
BLOCK_TIMEOUT_MS=3000

# 节流：状态签名不变时，N 秒内不重复贴同一块
INJECT_THROTTLE_ENABLED=true
INJECT_THROTTLE_SECONDS=1800

# 源不可达时，N 秒内不再重试（避免每请求都等超时）
DEGRADE_COOLDOWN_MS=15000

# 对话快照推送（判定器的输入来源）
OBSERVE_ENABLED=true

# ── 路由表（纯字符串匹配）────────────────────────
MCP_PATHS=/cadence/mcp,/cadence/mcp/,/mcp,/mcp/
SURF_FINDING_PATH=/surf/finding

LOG_FILE=/root/pipeline-gateway/data/pipeline.log

# ── 预留：surf 作为独立注入源（待接口定稿后启用）──
# SURF_BASE=http://127.0.0.1:18222
# SURF_TOKEN=
# SURF_INJECT_PATH=/pipeline/inject
# SURF_ENABLED=false
